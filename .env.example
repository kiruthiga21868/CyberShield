# ---------------------------------------------------------------------------
# CyberShield AI - example environment file
#
# Copy this file to `.env` and fill in the values you actually have.
# `.env` is git-ignored, so your keys are never committed.
#
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# BOTH SERVICES ARE OPTIONAL. The application starts and remains fully usable
# without either key:
#   - no GROQ_API_KEY        -> the chatbot answers from its offline knowledge base
#   - no VIRUSTOTAL_API_KEY  -> URL scans use the local model and rule layer only
# ---------------------------------------------------------------------------

# --- Groq AI chatbot (optional) ---------------------------------------------
# Get a key at https://console.groq.com/keys
# Example only - replace with your own key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30
GROQ_MAX_TOKENS=800
GROQ_TEMPERATURE=0.3

# --- VirusTotal URL reputation (optional) -----------------------------------
# Get a key at https://www.virustotal.com/gui/my-apikey
# The free tier allows roughly 4 lookups/minute and 500/day, so results are
# cached and requests are rate limited automatically.
# Example only - replace with your own key.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT=10
VIRUSTOTAL_MIN_INTERVAL_SECONDS=15
VIRUSTOTAL_CACHE_TTL_SECONDS=900
